{
  "name": "bricks-map",
  "version": "1.0.0",
  "private": true,
  "description": "Vertical brick mind map whiteboard for Windows",
  "author": "Karen",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.bricksmap.app",
    "productName": "Bricks Map",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wait-on": "^8.0.1"
  }
}
